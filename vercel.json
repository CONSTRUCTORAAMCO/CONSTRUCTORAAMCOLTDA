{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "amcoltda.com"
        }
      ],
      "destination": "https://www.amcoltda.com/:path*",
      "permanent": true
    },
    {
      "source": "/proyectos/:id",
      "destination": "/proyecto/:id",
      "permanent": true
    },
    {
      "source": "/about",
      "destination": "/nosotros",
      "permanent": true
    },
    {
      "source": "/contact",
      "destination": "/contacto",
      "permanent": true
    },
    {
      "source": "/politica-privacidad",
      "destination": "/politicaprivacidad",
      "permanent": true
    },
    {
      "source": "/terminos-y-condiciones",
      "destination": "/tyc",
      "permanent": true
    },
    {
      "source": "/project/universidad-javeriana-edificio-gabriel-girlado",
      "destination": "/proyecto/9",
      "permanent": true
    }
  ]
}
